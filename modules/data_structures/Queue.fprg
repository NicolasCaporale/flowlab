<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Queue"/>
        <attribute name="authors" value="FlowLab"/>
        <attribute name="about" value="Queue (FIFO) of items of type T, like java.util.Queue: the items leave in the order they entered. It is a linked list of Node&lt;T&gt; nodes. remove and peek on an empty queue throw NoSuchElement, as remove() and element() in Java."/>
        <attribute name="saved" value="2026-11-17 08:00:00 AM"/>
        <attribute name="created" value="Zmxvd2xhYjttb2R1bGVzOzIwMjYtMTEtMTcgMDg6MDA6MDAgQU07MQ=="/>
        <attribute name="edited" value="Zmxvd2xhYjttb2R1bGVzOzIwMjYtMTEtMTcgMDg6MDA6MDAgQU07MQ=="/>
    </attributes>
    <flowlab-classes>
        <class name="QueueTest" parent="" x="40" y="360"/>
        <class name="Queue" parent="" tparams="T" x="40" y="40">
            <attribute name="head" type="Node&lt;T&gt;" array="False" size="" visibility="private" static="False" init=""/>
            <attribute name="last" type="Node&lt;T&gt;" array="False" size="" visibility="private" static="False" init=""/>
            <attribute name="count" type="Integer" array="False" size="" visibility="private" static="False" init="0"/>
        </class>
        <class name="Node" parent="" tparams="T" x="40" y="330">
            <attribute name="value" type="T" array="False" size="" visibility="public" static="False" init=""/>
            <attribute name="next" type="Node&lt;T&gt;" array="False" size="" visibility="public" static="False" init=""/>
        </class>
    </flowlab-classes>
    <function name="Main" type="None" variable="" flowlab-class="QueueTest" flowlab-visibility="public" flowlab-static="True">
        <parameters/>
        <body>
            <comment text="Test of the module: this Main is not imported"/>
            <declare name="line" type="Queue&lt;Integer&gt;" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="line" expression="new Queue&lt;Integer&gt;()"/>
            <for variable="i" start="1" end="5" direction="inc" step="1">
                <call expression="line.add(i * 10)"/>
            </for>
            <output expression="&quot;First in the queue: &quot; &amp; line.peek() &amp; &quot; of &quot; &amp; line.size()" newline="True"/>
            <declare name="copyList" type="Queue&lt;Integer&gt;" array="False" size=""/>
            <assign variable="copyList" expression="new Queue&lt;Integer&gt;(line)"/>
            <call expression="copyList.remove()"/>
            <output expression="&quot;The copy has &quot; &amp; copyList.size() &amp; &quot; items, the queue &quot; &amp; line.size()" newline="True"/>
            <while expression="not line.isEmpty()">
                <output expression="line.remove() &amp; &quot; &quot;" newline="False"/>
            </while>
            <output expression="&quot;&quot;" newline="True"/>
            <comment text="remove on the empty queue: NoSuchElement, as in Java"/>
            <try>
                <body>
                    <output expression="line.remove()" newline="True"/>
                </body>
                <catch type="NoSuchElement" variable="e">
                    <output expression="&quot;The queue is empty: nothing to remove&quot;" newline="True"/>
                </catch>
            </try>
        </body>
    </function>
    <function name="Node" type="None" variable="" flowlab-class="Node" flowlab-visibility="public" flowlab-static="False" flowlab-ctor="True">
        <parameters>
            <parameter name="v" type="T" array="False"/>
        </parameters>
        <body>
            <assign variable="value" expression="v"/>
            <assign variable="next" expression="null"/>
        </body>
    </function>
    <function name="Queue" type="None" variable="" flowlab-class="Queue" flowlab-visibility="public" flowlab-static="False" flowlab-ctor="True">
        <parameters/>
        <body>
            <comment text="Empty queue, like new LinkedList&lt;&gt;() in Java"/>
        </body>
    </function>
    <function name="Queue" type="None" variable="" flowlab-class="Queue" flowlab-visibility="public" flowlab-static="False" flowlab-ctor="True">
        <parameters>
            <parameter name="other" type="Queue&lt;T&gt;" array="False"/>
        </parameters>
        <body>
            <comment text="Copy of the items of another queue, in the same order, like new LinkedList&lt;&gt;(other) in Java"/>
            <declare name="n" type="Node&lt;T&gt;" array="False" size=""/>
            <assign variable="n" expression="other.head"/>
            <while expression="n != null">
                <call expression="add(n.value)"/>
                <assign variable="n" expression="n.next"/>
            </while>
        </body>
    </function>
    <function name="add" type="None" variable="" flowlab-class="Queue" flowlab-visibility="public" flowlab-static="False">
        <parameters>
            <parameter name="x" type="T" array="False"/>
        </parameters>
        <body>
            <declare name="n" type="Node&lt;T&gt;" array="False" size=""/>
            <assign variable="n" expression="new Node&lt;T&gt;(x)"/>
            <if expression="last = null">
                <then>
                    <assign variable="head" expression="n"/>
                </then>
                <else>
                    <assign variable="last.next" expression="n"/>
                </else>
            </if>
            <assign variable="last" expression="n"/>
            <assign variable="count" expression="count + 1"/>
        </body>
    </function>
    <function name="remove" type="T" variable="first" flowlab-class="Queue" flowlab-visibility="public" flowlab-static="False">
        <parameters/>
        <body>
            <comment text="Removes and returns the first item of the line"/>
            <if expression="count = 0">
                <then>
                    <throw expression="new NoSuchElement(&quot;The queue is empty&quot;)"/>
                </then>
                <else/>
            </if>
            <declare name="first" type="T" array="False" size=""/>
            <assign variable="first" expression="head.value"/>
            <assign variable="head" expression="head.next"/>
            <if expression="head = null">
                <then>
                    <assign variable="last" expression="null"/>
                </then>
                <else/>
            </if>
            <assign variable="count" expression="count - 1"/>
        </body>
    </function>
    <function name="peek" type="T" variable="first" flowlab-class="Queue" flowlab-visibility="public" flowlab-static="False">
        <parameters/>
        <body>
            <comment text="First item, without removing it; on an empty queue NoSuchElement, like element() in Java"/>
            <if expression="count = 0">
                <then>
                    <throw expression="new NoSuchElement(&quot;The queue is empty&quot;)"/>
                </then>
                <else/>
            </if>
            <declare name="first" type="T" array="False" size=""/>
            <assign variable="first" expression="head.value"/>
        </body>
    </function>
    <function name="size" type="Integer" variable="n" flowlab-class="Queue" flowlab-visibility="public" flowlab-static="False">
        <parameters/>
        <body>
            <declare name="n" type="Integer" array="False" size=""/>
            <assign variable="n" expression="count"/>
        </body>
    </function>
    <function name="isEmpty" type="Boolean" variable="empty" flowlab-class="Queue" flowlab-visibility="public" flowlab-static="False">
        <parameters/>
        <body>
            <declare name="empty" type="Boolean" array="False" size=""/>
            <assign variable="empty" expression="count = 0"/>
        </body>
    </function>
</flowgorithm>
