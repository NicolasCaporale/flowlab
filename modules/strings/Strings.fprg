<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Strings"/>
        <attribute name="authors" value="FlowLab"/>
        <attribute name="about" value="Functions on strings, like the methods of String in Java: Substring(s, beginIndex, endIndex), IndexOf, Contains, StartsWith, EndsWith, ToUpper, ToLower, Trim, Replace, Split (an array of strings) and IsDigit, IsLetter for a character. Positions start from 0. In the generated code they become the functions of each language."/>
        <attribute name="saved" value="2026-11-17 08:00:00 AM"/>
        <attribute name="created" value="Zmxvd2xhYjttb2R1bGVzOzIwMjYtMTEtMTcgMDg6MDA6MDAgQU07MQ=="/>
        <attribute name="edited" value="Zmxvd2xhYjttb2R1bGVzOzIwMjYtMTEtMTcgMDg6MDA6MDAgQU07MQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Test of the module: this Main is not imported"/>
            <declare name="s, t" type="String" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <declare name="parts" type="String" array="True" size="1"/>
            <assign variable="s" expression="&quot;  Hello, World!  &quot;"/>
            <assign variable="t" expression="Trim(s)"/>
            <output expression="&quot;[&quot; &amp; t &amp; &quot;] &quot; &amp; Len(t)" newline="True"/>
            <output expression="Substring(t, 0, 5) &amp; &quot; &quot; &amp; IndexOf(t, &quot;World&quot;) &amp; &quot; &quot; &amp; IndexOf(t, &quot;xyz&quot;)" newline="True"/>
            <output expression="Contains(t, &quot;lo, W&quot;) &amp; &quot; &quot; &amp; StartsWith(t, &quot;Hello&quot;) &amp; &quot; &quot; &amp; EndsWith(t, &quot;?&quot;)" newline="True"/>
            <output expression="ToUpper(t) &amp; &quot; &quot; &amp; ToLower(&quot;ABC def&quot;)" newline="True"/>
            <output expression="Replace(&quot;banana&quot;, &quot;na&quot;, &quot;NA&quot;) &amp; &quot; &quot; &amp; Replace(&quot;ab&quot;, &quot;&quot;, &quot;-&quot;)" newline="True"/>
            <assign variable="parts" expression="Split(&quot;Rossi;7;;8&quot;, &quot;;&quot;)"/>
            <for variable="i" start="0" end="Size(parts) - 1" direction="inc" step="1">
                <output expression="&quot;[&quot; &amp; parts[i] &amp; &quot;]&quot;" newline="False"/>
            </for>
            <output expression="&quot; &quot; &amp; Size(parts)" newline="True"/>
            <output expression="IsDigit(&quot;7&quot;) &amp; &quot; &quot; &amp; IsDigit(&quot;a&quot;) &amp; &quot; &quot; &amp; IsLetter(&quot;x&quot;) &amp; &quot; &quot; &amp; IsLetter(&quot;?&quot;) &amp; &quot; &quot; &amp; IsDigit(&quot;12&quot;)" newline="True"/>
            <comment text="Positions outside the string: IndexOutOfRange, as in Java"/>
            <try>
                <body>
                    <output expression="Substring(&quot;abc&quot;, 2, 5)" newline="True"/>
                </body>
                <catch type="IndexOutOfRange" variable="e">
                    <output expression="&quot;Error: &quot; &amp; e.message" newline="True"/>
                </catch>
            </try>
        </body>
    </function>
    <function name="Substring" type="String" variable="sub">
        <parameters>
            <parameter name="s" type="String" array="False"/>
            <parameter name="beginIndex" type="Integer" array="False"/>
            <parameter name="endIndex" type="Integer" array="False"/>
        </parameters>
        <body>
            <comment text="The characters from beginIndex to endIndex, endIndex excluded, as in Java: Substring(&quot;hello&quot;, 1, 3) = &quot;el&quot;"/>
            <if expression="beginIndex &lt; 0 or endIndex &gt; Len(s) or beginIndex &gt; endIndex">
                <then>
                    <throw expression="new IndexOutOfRange(&quot;Range [&quot; &amp; beginIndex &amp; &quot;, &quot; &amp; endIndex &amp; &quot;) out of bounds for length &quot; &amp; Len(s))"/>
                </then>
                <else/>
            </if>
            <declare name="sub" type="String" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="sub" expression="&quot;&quot;"/>
            <for variable="i" start="beginIndex" end="endIndex - 1" direction="inc" step="1">
                <assign variable="sub" expression="sub &amp; Char(s, i)"/>
            </for>
        </body>
    </function>
    <function name="IndexOf" type="Integer" variable="position">
        <parameters>
            <parameter name="s" type="String" array="False"/>
            <parameter name="t" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="Position of the first t in s, -1 if it is not there"/>
            <declare name="position, i, k" type="Integer" array="False" size=""/>
            <assign variable="position" expression="-1"/>
            <assign variable="i" expression="0"/>
            <while expression="position = -1 and i &lt;= Len(s) - Len(t)">
                <assign variable="k" expression="0"/>
                <while expression="k &lt; Len(t) and Char(s, i + k) = Char(t, k)">
                    <assign variable="k" expression="k + 1"/>
                </while>
                <if expression="k = Len(t)">
                    <then>
                        <assign variable="position" expression="i"/>
                    </then>
                    <else/>
                </if>
                <assign variable="i" expression="i + 1"/>
            </while>
        </body>
    </function>
    <function name="Contains" type="Boolean" variable="found">
        <parameters>
            <parameter name="s" type="String" array="False"/>
            <parameter name="t" type="String" array="False"/>
        </parameters>
        <body>
            <declare name="found" type="Boolean" array="False" size=""/>
            <assign variable="found" expression="IndexOf(s, t) &gt;= 0"/>
        </body>
    </function>
    <function name="StartsWith" type="Boolean" variable="result">
        <parameters>
            <parameter name="s" type="String" array="False"/>
            <parameter name="t" type="String" array="False"/>
        </parameters>
        <body>
            <declare name="result" type="Boolean" array="False" size=""/>
            <assign variable="result" expression="Len(t) &lt;= Len(s) and Substring(s, 0, Len(t)) = t"/>
        </body>
    </function>
    <function name="EndsWith" type="Boolean" variable="result">
        <parameters>
            <parameter name="s" type="String" array="False"/>
            <parameter name="t" type="String" array="False"/>
        </parameters>
        <body>
            <declare name="result" type="Boolean" array="False" size=""/>
            <assign variable="result" expression="Len(t) &lt;= Len(s) and Substring(s, Len(s) - Len(t), Len(s)) = t"/>
        </body>
    </function>
    <function name="ToUpper" type="String" variable="r">
        <parameters>
            <parameter name="s" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="Lowercase letters (also the accented ones) become uppercase: the code of the character goes down by 32"/>
            <declare name="r" type="String" array="False" size=""/>
            <declare name="i, c" type="Integer" array="False" size=""/>
            <assign variable="r" expression="&quot;&quot;"/>
            <for variable="i" start="0" end="Len(s) - 1" direction="inc" step="1">
                <assign variable="c" expression="ToCode(Char(s, i))"/>
                <if expression="(c &gt;= 97 and c &lt;= 122) or (c &gt;= 224 and c &lt;= 254 and c != 247)">
                    <then>
                        <assign variable="c" expression="c - 32"/>
                    </then>
                    <else/>
                </if>
                <assign variable="r" expression="r &amp; ToChar(c)"/>
            </for>
        </body>
    </function>
    <function name="ToLower" type="String" variable="r">
        <parameters>
            <parameter name="s" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="Uppercase letters (also the accented ones) become lowercase: the code of the character goes up by 32"/>
            <declare name="r" type="String" array="False" size=""/>
            <declare name="i, c" type="Integer" array="False" size=""/>
            <assign variable="r" expression="&quot;&quot;"/>
            <for variable="i" start="0" end="Len(s) - 1" direction="inc" step="1">
                <assign variable="c" expression="ToCode(Char(s, i))"/>
                <if expression="(c &gt;= 65 and c &lt;= 90) or (c &gt;= 192 and c &lt;= 222 and c != 215)">
                    <then>
                        <assign variable="c" expression="c + 32"/>
                    </then>
                    <else/>
                </if>
                <assign variable="r" expression="r &amp; ToChar(c)"/>
            </for>
        </body>
    </function>
    <function name="Trim" type="String" variable="r">
        <parameters>
            <parameter name="s" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="Without the spaces (and tabs, new lines) at the beginning and at the end"/>
            <declare name="r" type="String" array="False" size=""/>
            <declare name="a, b" type="Integer" array="False" size=""/>
            <assign variable="a" expression="0"/>
            <assign variable="b" expression="Len(s) - 1"/>
            <while expression="a &lt;= b and ToCode(Char(s, a)) &lt;= 32">
                <assign variable="a" expression="a + 1"/>
            </while>
            <while expression="b &gt;= a and ToCode(Char(s, b)) &lt;= 32">
                <assign variable="b" expression="b - 1"/>
            </while>
            <assign variable="r" expression="Substring(s, a, b + 1)"/>
        </body>
    </function>
    <function name="Replace" type="String" variable="r">
        <parameters>
            <parameter name="s" type="String" array="False"/>
            <parameter name="target" type="String" array="False"/>
            <parameter name="replacement" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="Every target in s replaced by replacement, from left to right"/>
            <declare name="r" type="String" array="False" size=""/>
            <declare name="i" type="Integer" array="False" size=""/>
            <assign variable="i" expression="0"/>
            <if expression="Len(target) = 0">
                <then>
                    <comment text="An empty target: replacement between all the characters, as in Java"/>
                    <assign variable="r" expression="replacement"/>
                    <for variable="i" start="0" end="Len(s) - 1" direction="inc" step="1">
                        <assign variable="r" expression="r &amp; Char(s, i) &amp; replacement"/>
                    </for>
                </then>
                <else>
                    <assign variable="r" expression="&quot;&quot;"/>
                    <while expression="i &lt; Len(s)">
                        <if expression="i &lt;= Len(s) - Len(target) and Substring(s, i, i + Len(target)) = target">
                            <then>
                                <assign variable="r" expression="r &amp; replacement"/>
                                <assign variable="i" expression="i + Len(target)"/>
                            </then>
                            <else>
                                <assign variable="r" expression="r &amp; Char(s, i)"/>
                                <assign variable="i" expression="i + 1"/>
                            </else>
                        </if>
                    </while>
                </else>
            </if>
        </body>
    </function>
    <function name="Split" type="String" variable="parts" flowlab-returns="parts:String[]">
        <parameters>
            <parameter name="s" type="String" array="False"/>
            <parameter name="separator" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="The pieces of s between the separators, also the empty ones: Split(&quot;a;b;;c&quot;, &quot;;&quot;) = {&quot;a&quot;, &quot;b&quot;, &quot;&quot;, &quot;c&quot;}"/>
            <if expression="Len(separator) = 0">
                <then>
                    <throw expression="new InvalidArgument(&quot;The separator is empty&quot;)"/>
                </then>
                <else/>
            </if>
            <declare name="count, i, k, start" type="Integer" array="False" size=""/>
            <assign variable="count" expression="1"/>
            <assign variable="i" expression="0"/>
            <while expression="i &lt;= Len(s) - Len(separator)">
                <if expression="Substring(s, i, i + Len(separator)) = separator">
                    <then>
                        <assign variable="count" expression="count + 1"/>
                        <assign variable="i" expression="i + Len(separator)"/>
                    </then>
                    <else>
                        <assign variable="i" expression="i + 1"/>
                    </else>
                </if>
            </while>
            <declare name="parts" type="String" array="True" size="count"/>
            <assign variable="k" expression="0"/>
            <assign variable="start" expression="0"/>
            <assign variable="i" expression="0"/>
            <while expression="i &lt;= Len(s) - Len(separator)">
                <if expression="Substring(s, i, i + Len(separator)) = separator">
                    <then>
                        <assign variable="parts[k]" expression="Substring(s, start, i)"/>
                        <assign variable="k" expression="k + 1"/>
                        <assign variable="i" expression="i + Len(separator)"/>
                        <assign variable="start" expression="i"/>
                    </then>
                    <else>
                        <assign variable="i" expression="i + 1"/>
                    </else>
                </if>
            </while>
            <assign variable="parts[k]" expression="Substring(s, start, Len(s))"/>
        </body>
    </function>
    <function name="IsDigit" type="Boolean" variable="result">
        <parameters>
            <parameter name="c" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="True if c is a single digit character, 0 to 9"/>
            <declare name="result" type="Boolean" array="False" size=""/>
            <assign variable="result" expression="Len(c) = 1 and ToCode(c) &gt;= 48 and ToCode(c) &lt;= 57"/>
        </body>
    </function>
    <function name="IsLetter" type="Boolean" variable="result">
        <parameters>
            <parameter name="c" type="String" array="False"/>
        </parameters>
        <body>
            <comment text="True if c is a single letter, also accented"/>
            <declare name="result" type="Boolean" array="False" size=""/>
            <declare name="x" type="Integer" array="False" size=""/>
            <assign variable="x" expression="0"/>
            <if expression="Len(c) = 1">
                <then>
                    <assign variable="x" expression="ToCode(c)"/>
                </then>
                <else/>
            </if>
            <assign variable="result" expression="(x &gt;= 65 and x &lt;= 90) or (x &gt;= 97 and x &lt;= 122) or (x &gt;= 192 and x &lt;= 255 and x != 215 and x != 247)"/>
        </body>
    </function>
</flowgorithm>
