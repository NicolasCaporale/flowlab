<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Search"/>
        <attribute name="authors" value="FlowLab"/>
        <attribute name="about" value="Functions to search for a value x in an array of integers: linearSearch(v, n, x) for any array and binarySearch(v, n, x) for a sorted array. They return the position of the value or -1 if it is not there."/>
        <attribute name="saved" value="2026-11-17 08:00:00 AM"/>
        <attribute name="created" value="Zmxvd2xhYjttb2R1bGVzOzIwMjYtMTEtMTcgMDg6MDA6MDAgQU07MQ=="/>
        <attribute name="edited" value="Zmxvd2xhYjttb2R1bGVzOzIwMjYtMTEtMTcgMDg6MDA6MDAgQU07MQ=="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Test of the module: this Main is not imported"/>
            <declare name="v" type="Integer" array="True" size="6"/>
            <declare name="i" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="5" direction="inc" step="1">
                <assign variable="v[i]" expression="i * 3"/>
            </for>
            <output expression="&quot;15 is at position &quot; &amp; binarySearch(v, 6, 15) &amp; &quot;, 7 at position &quot; &amp; linearSearch(v, 6, 7)" newline="True"/>
        </body>
    </function>
    <function name="linearSearch" type="Integer" variable="position">
        <parameters>
            <parameter name="v" type="Integer" array="True"/>
            <parameter name="n" type="Integer" array="False"/>
            <parameter name="x" type="Integer" array="False"/>
        </parameters>
        <body>
            <comment text="Checks the items one after the other"/>
            <declare name="position, i" type="Integer" array="False" size=""/>
            <assign variable="position" expression="-1"/>
            <assign variable="i" expression="0"/>
            <while expression="position = -1 and i &lt; n">
                <if expression="v[i] = x">
                    <then>
                        <assign variable="position" expression="i"/>
                    </then>
                    <else/>
                </if>
                <assign variable="i" expression="i + 1"/>
            </while>
        </body>
    </function>
    <function name="binarySearch" type="Integer" variable="position">
        <parameters>
            <parameter name="v" type="Integer" array="True"/>
            <parameter name="n" type="Integer" array="False"/>
            <parameter name="x" type="Integer" array="False"/>
        </parameters>
        <body>
            <comment text="The array must be sorted: at each step the part to search is halved"/>
            <declare name="position, low, high, mid" type="Integer" array="False" size=""/>
            <assign variable="position" expression="-1"/>
            <assign variable="low" expression="0"/>
            <assign variable="high" expression="n - 1"/>
            <while expression="position = -1 and low &lt;= high">
                <assign variable="mid" expression="Int((low + high) / 2)"/>
                <if expression="v[mid] = x">
                    <then>
                        <assign variable="position" expression="mid"/>
                    </then>
                    <else>
                        <if expression="v[mid] &lt; x">
                            <then>
                                <assign variable="low" expression="mid + 1"/>
                            </then>
                            <else>
                                <assign variable="high" expression="mid - 1"/>
                            </else>
                        </if>
                    </else>
                </if>
            </while>
        </body>
    </function>
</flowgorithm>
