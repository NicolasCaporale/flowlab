{
  "id": "./FlowLab.html",
  "name": "FlowLab",
  "short_name": "FlowLab",
  "lang": "en",
  "description": "Flowchart editor and runner compatible with .fprg files",
  "start_url": "./FlowLab.html",
  "scope": "./",
  "display": "standalone",
  "background_color": "#e9edf1",
  "theme_color": "#0c6c80",
  "icons": [
    {
      "src": "icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],
  "file_handlers": [
    {
      "action": "./FlowLab.html",
      "accept": {
        "application/x-fprg": [
          ".fprg"
        ]
      },
      "icons": [
        {
          "src": "icon-512.png",
          "sizes": "512x512",
          "type": "image/png"
        }
      ],
      "launch_type": "multiple-clients"
    }
  ]
}
