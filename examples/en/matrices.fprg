<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Matrices and cubes"/>
        <attribute name="authors" value="FlowLab examples"/>
        <attribute name="about" value="Fills a 10 × 10 multiplication table, a 4 × 6 × 8 cube and a 4-dimensional array. Open the arrays from the Variables tab and run with Step."/>
        <attribute name="saved" value="2026-11-17 08:00:00 PM"/>
        <attribute name="created" value="Zmxvd2xhYjtleGFtcGxlczsyMDI2LTExLTE3IDA4OjAwOjAwIFBNOzE="/>
        <attribute name="edited" value="Zmxvd2xhYjtleGFtcGxlczsyMDI2LTExLTE3IDA4OjAwOjAwIFBNOzE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <comment text="Open the Variables tab and press the button next to an array to see it in a window."/>
            <declare name="N" type="Integer" array="False" size="" flowlab-const="True"/>
            <assign variable="N" expression="10"/>
            <declare name="table" type="Integer" array="True" size="N, N"/>
            <declare name="cube" type="Integer" array="True" size="4, 6, 8"/>
            <declare name="four" type="Integer" array="True" size="2, 3, 4, 5"/>
            <declare name="i, j, k, l" type="Integer" array="False" size=""/>
            <for variable="i" start="0" end="N - 1" direction="inc" step="1">
                <for variable="j" start="0" end="N - 1" direction="inc" step="1">
                    <assign variable="table[i, j]" expression="(i + 1) * (j + 1)"/>
                </for>
            </for>
            <for variable="i" start="0" end="Size(cube, 0) - 1" direction="inc" step="1">
                <for variable="j" start="0" end="Size(cube, 1) - 1" direction="inc" step="1">
                    <for variable="k" start="0" end="Size(cube, 2) - 1" direction="inc" step="1">
                        <assign variable="cube[i][j][k]" expression="i * 100 + j * 10 + k"/>
                    </for>
                </for>
            </for>
            <for variable="i" start="0" end="1" direction="inc" step="1">
                <for variable="j" start="0" end="2" direction="inc" step="1">
                    <for variable="k" start="0" end="3" direction="inc" step="1">
                        <for variable="l" start="0" end="4" direction="inc" step="1">
                            <assign variable="four[i, j, k, l]" expression="i + j + k + l"/>
                        </for>
                    </for>
                </for>
            </for>
            <output expression="&quot;7 × 8 = &quot; &amp; table[6, 7] &amp; &quot; · cube[3, 5, 7] = &quot; &amp; cube[3, 5, 7] &amp; &quot; · diagonal sum = &quot; &amp; DiagonalSum(table)" newline="True"/>
        </body>
    </function>
    <function name="DiagonalSum" type="Integer" variable="s">
        <parameters>
            <parameter name="m" type="Integer" array="True" flowlab-dims="2"/>
        </parameters>
        <body>
            <declare name="s, i" type="Integer" array="False" size=""/>
            <assign variable="s" expression="0"/>
            <for variable="i" start="0" end="Size(m) - 1" direction="inc" step="1">
                <assign variable="s" expression="s + m[i, i]"/>
            </for>
        </body>
    </function>
</flowgorithm>
