<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Squares in a file"/>
        <attribute name="authors" value="FlowLab examples"/>
        <attribute name="about" value="Writes the squares to a file and then reads them back until the file ends."/>
        <attribute name="saved" value="2026-11-17 08:00:00 PM"/>
        <attribute name="created" value="Zmxvd2xhYjtleGFtcGxlczsyMDI2LTExLTE3IDA4OjAwOjAwIFBNOzE="/>
        <attribute name="edited" value="Zmxvd2xhYjtleGFtcGxlczsyMDI2LTExLTE3IDA4OjAwOjAwIFBNOzE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="i, q, sum" type="Integer" array="False" size=""/>
            <open expression="&quot;squares.txt&quot;" mode="write"/>
            <for variable="i" start="1" end="5" direction="inc" step="1">
                <write expression="i * i"/>
            </for>
            <close mode="write"/>
            <output expression="&quot;I wrote squares.txt (you will find it in the Files tab)&quot;" newline="True"/>
            <assign variable="sum" expression="0"/>
            <open expression="&quot;squares.txt&quot;" mode="read"/>
            <while expression="not EOF()">
                <read variable="q"/>
                <output expression="&quot;Read &quot; &amp; q" newline="True"/>
                <assign variable="sum" expression="sum + q"/>
            </while>
            <close mode="read"/>
            <output expression="&quot;Sum = &quot; &amp; sum" newline="True"/>
        </body>
    </function>
</flowgorithm>
