<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Grade average"/>
        <attribute name="authors" value="FlowLab examples"/>
        <attribute name="about" value="Reads N grades, computes the average and says whether it is a pass."/>
        <attribute name="saved" value="2026-11-17 08:00:00 PM"/>
        <attribute name="created" value="Zmxvd2xhYjtleGFtcGxlczsyMDI2LTExLTE3IDA4OjAwOjAwIFBNOzE="/>
        <attribute name="edited" value="Zmxvd2xhYjtleGFtcGxlczsyMDI2LTExLTE3IDA4OjAwOjAwIFBNOzE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n, i" type="Integer" array="False" size=""/>
            <declare name="grade, sum, average" type="Real" array="False" size=""/>
            <output expression="&quot;How many grades do you want to enter?&quot;" newline="True"/>
            <input variable="n"/>
            <assign variable="sum" expression="0"/>
            <for variable="i" start="1" end="n" direction="inc" step="1">
                <output expression="&quot;Grade &quot; &amp; i &amp; &quot;: &quot;" newline="False"/>
                <input variable="grade"/>
                <assign variable="sum" expression="sum + grade"/>
            </for>
            <if expression="n &gt; 0">
                <then>
                    <assign variable="average" expression="sum / n"/>
                    <output expression="&quot;Average: &quot; &amp; ToFixed(average, 2)" newline="True"/>
                    <if expression="average &gt;= 6">
                        <then>
                            <output expression="&quot;Pass&quot;" newline="True"/>
                        </then>
                        <else>
                            <output expression="&quot;Fail&quot;" newline="True"/>
                        </else>
                    </if>
                </then>
                <else>
                    <output expression="&quot;No grades entered&quot;" newline="True"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
