<?xml version="1.0"?>
<flowgorithm fileversion="4.2">
    <attributes>
        <attribute name="name" value="Recursive factorial"/>
        <attribute name="authors" value="FlowLab examples"/>
        <attribute name="about" value="A function that calls itself."/>
        <attribute name="saved" value="2026-11-17 08:00:00 PM"/>
        <attribute name="created" value="Zmxvd2xhYjtleGFtcGxlczsyMDI2LTExLTE3IDA4OjAwOjAwIFBNOzE="/>
        <attribute name="edited" value="Zmxvd2xhYjtleGFtcGxlczsyMDI2LTExLTE3IDA4OjAwOjAwIFBNOzE="/>
    </attributes>
    <function name="Main" type="None" variable="">
        <parameters/>
        <body>
            <declare name="n" type="Integer" array="False" size=""/>
            <output expression="&quot;Computing n! — enter n&quot;" newline="True"/>
            <input variable="n"/>
            <output expression="n &amp; &quot;! = &quot; &amp; Factorial(n)" newline="True"/>
        </body>
    </function>
    <function name="Factorial" type="Integer" variable="result">
        <parameters>
            <parameter name="k" type="Integer" array="False"/>
        </parameters>
        <body>
            <declare name="result" type="Integer" array="False" size=""/>
            <if expression="k &lt;= 1">
                <then>
                    <assign variable="result" expression="1"/>
                </then>
                <else>
                    <assign variable="result" expression="k * Factorial(k - 1)"/>
                </else>
            </if>
        </body>
    </function>
</flowgorithm>
